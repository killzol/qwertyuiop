<Window x:Class="искулинария.Views.Windows.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Сброс пароля"
        Width="420"
        Height="360"
        MinWidth="400"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EFF7F7"
        Style="{StaticResource MaterialDesignWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="109" />
            <RowDefinition Height="Auto" MinHeight="121" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Новый пароль для пользователя:" Foreground="#536D70" />
            <TextBlock x:Name="UserNameText" FontSize="19" FontWeight="SemiBold" Foreground="#263E41" TextWrapping="Wrap" Margin="0,5,0,15" />
        </StackPanel>
        <StackPanel Margin="0,61,0,118" Grid.RowSpan="3">
            <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,10" materialDesign:HintAssist.Hint="Новый пароль" />
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,10" materialDesign:HintAssist.Hint="Повторите новый пароль" />
            <TextBlock Text="От 6 символов, заглавная буква, цифра и знак !@#$%^" Foreground="#536D70" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Width="220">
            <Button Width="100" Height="38" Margin="0,0,10,0" Content="Отмена" Style="{StaticResource MaterialDesignOutlinedButton}" Click="CancelButton_OnClick" />
            <Button x:Name="ChangeButton" Width="110" Height="38" Content="Изменить" Style="{StaticResource MaterialDesignRaisedButton}" Click="ChangeButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>