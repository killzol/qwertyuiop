<Window x:Class="искулинария.Views.RegistrationForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Регистрация нового пользователя"
        Width="440"
        Height="600"
        MinWidth="440"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        Style="{StaticResource MaterialDesignWindow}">
    <Grid Background="White">
        <StackPanel Width="280" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Регистрация нового пользователя"
                       Margin="0,0,0,18"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBox x:Name="LoginBox"
                     Height="42"
                     Margin="0,0,0,10"
                     Padding="6,8"
                     VerticalContentAlignment="Center"
                     materialDesign:HintAssist.Hint="Логин" />
            <TextBox x:Name="FirstNameBox"
                     Height="42"
                     Margin="0,0,0,10"
                     Padding="6,8"
                     VerticalContentAlignment="Center"
                     materialDesign:HintAssist.Hint="Имя" />
            <TextBox x:Name="LastNameBox"
                     Height="42"
                     Margin="0,0,0,10"
                     Padding="6,8"
                     VerticalContentAlignment="Center"
                     materialDesign:HintAssist.Hint="Фамилия" />
            <PasswordBox x:Name="PasswordBox"
                         Height="42"
                         Margin="0,0,0,10"
                         Padding="6,8"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="Пароль" />
            <PasswordBox x:Name="RepeatPasswordBox"
                         Height="42"
                         Margin="0,0,0,8"
                         Padding="6,8"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="Повторите пароль" />
            <TextBlock Text="Пароль: от 6 символов, заглавная буква, цифра и один символ из ! @ # $ % ^."
                       Margin="0,0,0,8"
                       FontSize="12"
                       Foreground="#555555"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText"
                       MinHeight="36"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#B3261E" />
            <Button x:Name="RegisterButton"
                    Height="36"
                    Content="Зарегистрироваться"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="RegisterButton_OnClick" />
            <Button Height="34"
                    Margin="0,8,0,0"
                    Content="Назад к авторизации"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="BackButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
