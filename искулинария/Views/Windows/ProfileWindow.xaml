<Window x:Class="искулинария.Views.Windows.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Профиль пользователя"
        Width="540"
        Height="720"
        MinWidth="480"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#EFF7F7"
        Style="{StaticResource MaterialDesignWindow}"
        Loaded="ProfileWindow_OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#263E41" Margin="0,0,0,16" ><Run Language="ru-ru" Text="Изменение Профиля"/></TextBlock>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2">
                <TextBox x:Name="FirstNameBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Имя *" />
                <TextBox x:Name="LastNameBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Фамилия *" />
                <TextBox x:Name="PatronymicBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Отчество" />
                <DatePicker x:Name="DateOfBirthday" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Дата рождения" />
                <TextBox x:Name="LoginBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Логин" />
                <TextBox x:Name="PhoneBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Телефон" />
                <TextBox x:Name="AddressBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Адрес" />
                <Button x:Name="ChangePasswordButton"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,12"
                        Content="Сменить пароль"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="ChangePasswordButton_OnClick" />
                <Border x:Name="PasswordPanel" Visibility="Collapsed" Padding="12" Margin="0,0,0,12" Background="#E5F1F2" CornerRadius="8">
                    <StackPanel>
                        <PasswordBox x:Name="OldPasswordBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Старый пароль" />
                        <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Новый пароль" />
                        <PasswordBox x:Name="ConfirmPasswordBox" materialDesign:HintAssist.Hint="Повторите новый пароль" />
                        <TextBlock Text="От 6 символов, заглавная буква, цифра и знак !@#$%^" Margin="0,8,0,0" Foreground="#536D70" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="110" Height="40" Margin="0,0,10,0" Content="Отмена" Style="{StaticResource MaterialDesignOutlinedButton}" Click="CancelButton_OnClick" />
            <Button x:Name="SaveButton" Width="120" Height="40" Content="Сохранить" Style="{StaticResource MaterialDesignRaisedButton}" Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>