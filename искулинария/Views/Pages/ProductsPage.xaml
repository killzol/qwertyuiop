<Page x:Class="искулинария.Views.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Продукты"
      Background="Transparent">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Продукты" FontSize="23" FontWeight="SemiBold" Foreground="#263E41" VerticalAlignment="Center" />
            <StackPanel x:Name="ProductButtons" Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Добавить" Margin="6,0" Padding="14,7" Style="{StaticResource MaterialDesignRaisedButton}" Click="AddProductButton_OnClick" />
                <Button Content="Удалить" Margin="6,0" Padding="14,7" Style="{StaticResource MaterialDesignOutlinedButton}" Click="DeleteProductButton_OnClick" />
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="ProductsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  AlternatingRowBackground="#F2F5FA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Продукт" Binding="{Binding Nazvanie}" Width="2*" />
                <DataGridTextColumn Header="Белки" Binding="{Binding Belki}" Width="*" />
                <DataGridTextColumn Header="Жиры" Binding="{Binding Zhiry}" Width="*" />
                <DataGridTextColumn Header="Углеводы" Binding="{Binding Uglevody}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" Foreground="#607572" TextWrapping="Wrap" />
    </Grid>
</Page>
