<Window x:Class="искулинария.Views.Windows.ProduktAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Добавить продукт"
        Width="440"
        Height="430"
        MinWidth="400"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EFF7F7"
        Style="{StaticResource MaterialDesignWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Новый продукт" FontSize="23" FontWeight="SemiBold" Foreground="#263E41" Margin="0,0,0,18" />

        <StackPanel Grid.Row="1">
            <TextBox x:Name="NameBox" Margin="0,0,0,12" MaxLength="50" materialDesign:HintAssist.Hint="Название продукта" />
            <TextBox x:Name="ProteinBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Белки" />
            <TextBox x:Name="FatBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Жиры" />
            <TextBox x:Name="CarbohydratesBox" Margin="0,0,0,12" materialDesign:HintAssist.Hint="Углеводы" />
            <TextBlock Text="Укажите целые значения от 0" FontSize="12" Foreground="#607572" />
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="#B3261E" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="100" Height="38" Margin="0,0,10,0" Style="{StaticResource MaterialDesignOutlinedButton}" Click="CancelButton_OnClick" />
            <Button Content="Добавить" Width="110" Height="38" Style="{StaticResource MaterialDesignRaisedButton}" Click="AddButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
