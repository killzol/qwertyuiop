<Page x:Class="искулинария.Views.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Пользователи"
      Background="Transparent">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Пользователи системы" FontSize="23" FontWeight="SemiBold" Foreground="#263E41" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Добавить" Margin="6,0" Padding="14,7" Style="{StaticResource MaterialDesignRaisedButton}" Click="AddUserButton_OnClick" />
                <Button x:Name="ResetPasswordButton" Content="Сброс пароля" Margin="6,0" Padding="14,7" IsEnabled="False" Style="{StaticResource MaterialDesignOutlinedButton}" Click="ResetPasswordButton_OnClick" />
                <Button x:Name="DeleteUserButton" Content="Удалить" Margin="6,0" Padding="14,7" IsEnabled="False" Style="{StaticResource MaterialDesignOutlinedButton}" Click="DeleteUserButton_OnClick" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="UsersGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionChanged="UsersGrid_OnSelectionChanged"
                      AlternatingRowBackground="#F2F5FA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="1.5*" />
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*" />
                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Padding="18" Background="#EAF4F5" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Данные пользователя" FontSize="19" FontWeight="SemiBold" Foreground="#263E41" Margin="0,0,0,14" />
                        <TextBox x:Name="FirstNameBox" Margin="0,0,0,10" IsEnabled="False" materialDesign:HintAssist.Hint="Имя" />
                        <TextBox x:Name="LastNameBox" Margin="0,0,0,10" IsEnabled="False" materialDesign:HintAssist.Hint="Фамилия" />
                        <TextBox x:Name="PatronymicBox" Margin="0,0,0,10" IsEnabled="False" materialDesign:HintAssist.Hint="Отчество" />
                        <TextBox x:Name="LoginBox" Margin="0,0,0,10" IsEnabled="False" materialDesign:HintAssist.Hint="Логин" />
                        <TextBox x:Name="PhoneBox" Margin="0,0,0,10" IsEnabled="False" materialDesign:HintAssist.Hint="Телефон" />
                        <TextBox x:Name="AddressBox" Margin="0,0,0,14" IsEnabled="False" materialDesign:HintAssist.Hint="Адрес" />
                        <ComboBox x:Name="RoleComboBox" Margin="0,0,0,12" IsEnabled="False" DisplayMemberPath="Value" SelectedValuePath="Key" materialDesign:HintAssist.Hint="Роль" />
                        <Button x:Name="ChangeRoleButton" Content="Сменить роль" IsEnabled="False" HorizontalAlignment="Left" Padding="14,7" Style="{StaticResource MaterialDesignRaisedButton}" Click="ChangeRoleButton_OnClick" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" Foreground="#607572" TextWrapping="Wrap" />
    </Grid>
</Page>